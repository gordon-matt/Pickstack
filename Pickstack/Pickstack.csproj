<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Description>Composition and shared browser runtime for Pickstack: pick a file manager and a rich text editor for ASP.NET Core and swap either one without changing your pages.</Description>
		<PackageTags>pickstack;aspnetcore;mvc;razor-pages;tag-helpers;file-manager;rich-text-editor;wysiwyg</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\pickstack.js" LogicalName="pickstack.js" />
		<EmbeddedResource Include="Assets\load.js" LogicalName="load.js" />
		<EmbeddedResource Include="Assets\editor.js" LogicalName="editor.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.FileManager\Pickstack.FileManager.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor\Pickstack.RichTextEditor.csproj" />
	</ItemGroup>

</Project>
