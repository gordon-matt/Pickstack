<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Description>CKEditor adapter for Pickstack. Opens a Pickstack browse page that hosts the registered file manager.</Description>
		<PackageTags>pickstack;aspnetcore;rich-text-editor;wysiwyg;html-editor;ckeditor</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\ckeditor.js" LogicalName="ckeditor.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.FileManager\Pickstack.FileManager.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor\Pickstack.RichTextEditor.csproj" />
		<ProjectReference Include="..\Pickstack\Pickstack.csproj" />
	</ItemGroup>

</Project>
