<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Description>Shared TinyMCE adapter for Pickstack. Reference it through a version package (TinyMce5 to TinyMce8) rather than directly.</Description>
		<PackageTags>pickstack;aspnetcore;rich-text-editor;wysiwyg;html-editor;tinymce</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\tinymce.js" LogicalName="tinymce.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.RichTextEditor\Pickstack.RichTextEditor.csproj" />
		<ProjectReference Include="..\Pickstack\Pickstack.csproj" />
	</ItemGroup>

</Project>
