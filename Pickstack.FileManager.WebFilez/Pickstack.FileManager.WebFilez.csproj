<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Description>WebFilez adapter for Pickstack. Provides the Pickstack file manager using WebFilez and its Blazor components.</Description>
		<PackageTags>pickstack;aspnetcore;blazor;file-manager;webfilez;file-browser;file-picker</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\webfilez.js" LogicalName="webfilez.js" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WebFilez.AspNetCore" />
		<PackageReference Include="WebFilez.Components" />
		<PackageReference Include="WebFilez.Plugins.FileRobot" />
		<PackageReference Include="WebFilez.Plugins.FortuneSheet" />
		<PackageReference Include="WebFilez.Plugins.SuperDoc" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.FileManager\Pickstack.FileManager.csproj" />
		<ProjectReference Include="..\Pickstack\Pickstack.csproj" />
	</ItemGroup>

</Project>
