<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Version>1.0.3</Version>
		<Description>TinyMCE 7.9.0 rich text editor for Pickstack, loaded from the CDN with a fallback copy shipped in the package.</Description>
		<PackageTags>pickstack;aspnetcore;rich-text-editor;wysiwyg;html-editor;tinymce;tinymce7</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.RichTextEditor.TinyMce\Pickstack.RichTextEditor.TinyMce.csproj" />
	</ItemGroup>

</Project>
