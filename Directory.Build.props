<Project>

	<PropertyGroup>
		<Authors>Matt Gordon</Authors>
		<Company>Matt Gordon</Company>
		<Product>Pickstack</Product>
		<Copyright>Copyright © Matt Gordon</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/gordon-matt/Pickstack</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/Pickstack</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)_Misc\Icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
