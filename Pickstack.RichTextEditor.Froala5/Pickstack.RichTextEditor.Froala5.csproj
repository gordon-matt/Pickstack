<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Version>1.0.3</Version>
		<Description>Froala Editor 5.5.0 rich text editor for Pickstack, loaded from the CDN with a fallback copy shipped in the package. A Froala license is required.</Description>
		<PackageTags>pickstack;aspnetcore;rich-text-editor;wysiwyg;html-editor;froala;froala5</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.RichTextEditor.Froala\Pickstack.RichTextEditor.Froala.csproj" />
	</ItemGroup>

</Project>
