<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Description>Shared Froala adapter for Pickstack. Reference it through the Froala5 version package rather than directly.</Description>
		<PackageTags>pickstack;aspnetcore;rich-text-editor;wysiwyg;html-editor;froala</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\froala.js" LogicalName="froala.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.RichTextEditor\Pickstack.RichTextEditor.csproj" />
		<ProjectReference Include="..\Pickstack\Pickstack.csproj" />
	</ItemGroup>

</Project>
