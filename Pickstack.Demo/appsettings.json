{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pickstack": {
    "FileManager": "WebFilez", // "elFinder" or "WebFilez" or "ResponsiveFileManager",
    "RichTextEditor": "TinyMCE7", // "TinyMCE5", "TinyMCE6", "TinyMCE7", "TinyMCE", "CKEditor" or "Froala5"
    "Storage": {
      "RequestPath": "/media/",
      "WebRootFolder": "media",
      "ThumbnailRequestPath": "/media-thumbs/",
      "ThumbnailWebRootFolder": "media-thumbs"
    }
  }
}