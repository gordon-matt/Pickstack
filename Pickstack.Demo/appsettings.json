{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pickstack": {
    "FileManager": "ResponsiveFileManager", //or "elFinder",
    "RichTextEditor": "TinyMCE", // or "CKEditor"
    "Storage": {
      "RequestPath": "/media/",
      "WebRootFolder": "media",
      "ThumbnailRequestPath": "/media-thumbs/",
      "ThumbnailWebRootFolder": "media-thumbs"
    }
  }
}
