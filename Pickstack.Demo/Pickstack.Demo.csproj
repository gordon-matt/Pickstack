<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Responsive File Manager's package targets net9.0. -->
		<AssetTargetFallback>$(AssetTargetFallback);net9.0</AssetTargetFallback>
		<!-- Serves _framework/blazor.server.js, which WebFilez needs. .NET 10 omits it unless the app asks. -->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pickstack.FileManager.elFinder\Pickstack.FileManager.elFinder.csproj" />
		<ProjectReference Include="..\Pickstack.FileManager.ResponsiveFileManager\Pickstack.FileManager.ResponsiveFileManager.csproj" />
		<ProjectReference Include="..\Pickstack.FileManager.WebFilez\Pickstack.FileManager.WebFilez.csproj" />
		<ProjectReference Include="..\Pickstack.FileManager\Pickstack.FileManager.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.CkEditor\Pickstack.RichTextEditor.CkEditor.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.Froala\Pickstack.RichTextEditor.Froala.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.Froala5\Pickstack.RichTextEditor.Froala5.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.TinyMce\Pickstack.RichTextEditor.TinyMce.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.TinyMce5\Pickstack.RichTextEditor.TinyMce5.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.TinyMce6\Pickstack.RichTextEditor.TinyMce6.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor.TinyMce7\Pickstack.RichTextEditor.TinyMce7.csproj" />
		<ProjectReference Include="..\Pickstack.RichTextEditor\Pickstack.RichTextEditor.csproj" />
		<ProjectReference Include="..\Pickstack\Pickstack.csproj" />
	</ItemGroup>

</Project>
